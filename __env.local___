# API Configuration
# Copy this file to .env.local and update the values as needed

# Internal backend URL - used by Next.js server to proxy API requests
# In production (Railway/Docker), set this to your internal service URL
# In development, use local backend
INTERNAL_BACKEND_URL=http://localhost:8080

NEXT_PUBLIC_API_VERSION=v1

# PI Terminology
# Controls the display term used throughout the UI for "Program Increment"
# Set to "PI" (default) or "Quarter" depending on customer preference
# This only affects display labels/titles - API parameters remain unchanged
NEXT_PUBLIC_PI_TERMINOLOGY=Quarter
