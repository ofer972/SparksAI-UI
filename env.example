# API Configuration
# Copy this file to .env.local and update the values as needed

# Public API Gateway URL - REQUIRED for production deployment
# In production, this should point directly to your API gateway (e.g., https://your-gateway.railway.app/api)
# In development, leave empty to use local proxy (http://localhost:3000/api -> http://localhost:8080)
NEXT_PUBLIC_API_BASE_URL=https://sparksai-gateway-production.up.railway.app/api

NEXT_PUBLIC_API_VERSION=v1

# Internal backend URL - only used for Next.js rewrites in development
# This is used by the Next.js server to proxy requests in dev mode
INTERNAL_BACKEND_URL=http://localhost:8080
